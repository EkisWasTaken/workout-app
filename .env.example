# Copy to .env and fill in. Everything prefixed VITE_ is inlined into the
# client bundle and is therefore PUBLIC — never put a secret here.

# Supabase project. The anon key is designed to be public; row level security
# is what protects the data, so this one is safe to ship.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The account that gets developer diagnostics (pending-migration banners naming
# the SQL file to run). Everyone else sees a plain-language message instead.
VITE_OWNER_EMAIL=you@example.com
